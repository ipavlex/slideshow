<?xml version="1.0" encoding="utf-8"?>
<!-- Строка списка/настроек: прозрачная, фокус — заливка surface + белая рамка (DESIGN.md §2). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/divider" />
            <corners android:radius="@dimen/corner_row" />
        </shape>
    </item>
    <!-- Pressed: как фокус — рамка не мигает в момент нажатия ОК. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/corner_row" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/corner_row" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/corner_row" />
        </shape>
    </item>
</selector>
