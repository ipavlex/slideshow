<?xml version="1.0" encoding="utf-8"?>
<!--
  listSelector для ListView: рисуется ПОВЕРХ строки (drawSelectorOnTop),
  поэтому только рамка/лёгкая заливка — текст остаётся читаемым.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#333D5AFE" />
            <stroke
                android:width="@dimen/focus_stroke_width"
                android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#333D5AFE" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
</selector>
