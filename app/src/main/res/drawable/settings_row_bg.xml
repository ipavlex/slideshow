<?xml version="1.0" encoding="utf-8"?>
<!--
    Строка настроек-карточка (прототип 07): default — surface,
    фокус — surface_elevated + белая рамка, нажатие — surface_pressed.
    Порядок состояний как в bg_tv_row: pressed важнее focused (ОК-клик).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <corners android:radius="@dimen/corner_large" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- Фокус НЕ меняет заливку (прототип 07): surface, иначе фон
                 контролов (surface_elevated) сливается с фоном строки. -->
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/corner_large" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/corner_large" />
        </shape>
    </item>
</selector>
