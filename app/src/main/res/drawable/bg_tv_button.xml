<?xml version="1.0" encoding="utf-8"?>
<!-- Нейтральная кнопка: приподнятая поверхность, фокус — белая рамка (DESIGN.md §2). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
    <!-- Pressed: заливка темнее, но рамка фокуса остаётся (без мигания). -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <corners android:radius="@dimen/corner_medium" />
        </shape>
    </item>
</selector>
