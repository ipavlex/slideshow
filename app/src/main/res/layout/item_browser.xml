<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="@dimen/browser_item_height"
    android:layout_margin="@dimen/small_spacing"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@drawable/bg_tv_button" android:padding="@dimen/menu_item_padding"
    android:focusable="true" android:clickable="true" android:stateListAnimator="@null">
    <ImageView android:id="@+id/browser_thumbnail" android:layout_width="match_parent"
        android:layout_height="@dimen/thumbnail_height" android:scaleType="centerCrop"
        android:contentDescription="@string/content_description_photo"/>
    <TextView android:id="@+id/name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/small_spacing"
        android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
        android:maxLines="1" android:ellipsize="middle"/>
    <TextView android:id="@+id/browser_subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" android:maxLines="1"/>
</LinearLayout>
