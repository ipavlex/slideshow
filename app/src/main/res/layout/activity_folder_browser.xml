<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/screen_padding_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/btn_back" android:layout_width="@dimen/menu_item_height" android:layout_height="@dimen/menu_item_height" android:background="@drawable/bg_tv_button" android:text="@string/back" android:textColor="@color/text_primary" android:textSize="@dimen/text_caption" android:focusable="true"/>
        <LinearLayout android:layout_width="@dimen/zero_size" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/medium_spacing">
            <TextView android:id="@+id/browser_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/folder_browser_title" style="@style/TextAppearance.TvSlideshow.Title" />
            <TextView android:id="@+id/browser_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/path_placeholder" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" android:singleLine="true" android:ellipsize="start"/>
        </LinearLayout>
        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/browser_list" android:layout_width="match_parent" android:layout_height="@dimen/zero_size" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="@dimen/menu_item_padding" android:scrollbars="none" android:layout_marginTop="@dimen/section_spacing"/>
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
    <Button android:id="@+id/btn_start_slideshow" android:layout_width="match_parent" android:layout_height="@dimen/menu_item_height" android:background="@drawable/bg_tv_button" android:text="@string/start_slideshow" android:textColor="@color/text_primary" android:textSize="@dimen/text_menu" android:padding="@dimen/menu_item_padding" android:focusable="true" android:clickable="true" android:stateListAnimator="@null" />
</LinearLayout>
