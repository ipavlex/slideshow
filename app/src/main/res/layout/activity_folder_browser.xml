<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран браузера папок (прототип 04): строка-путь над заголовком,
    нейтральная кнопка «Смотреть слайдшоу» с ▶-иконкой (первая в фокусе),
    вертикальный список строк. На время загрузки список скрыт, по центру
    области — спиннер + «Загрузка…», кнопка слайдшоу недоступна.
    Возврат на уровень выше — системной клавишей «Назад» (кнопки в шапке нет).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/screen_padding_vertical">

    <!-- Мелкая строка-путь над заголовком. -->
    <TextView android:id="@+id/browser_path"
        style="@style/TextAppearance.TvSlideshow.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/browser_root_title"
        android:singleLine="true" android:ellipsize="start"/>

    <TextView android:id="@+id/browser_title"
        style="@style/TextAppearance.TvSlideshow.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_spacing"
        android:text="@string/folder_browser_title"/>

    <!-- Нейтральная (не акцентная) кнопка запуска слайдшоу с ▶-иконкой. -->
    <Button android:id="@+id/btn_start_slideshow"
        style="@style/Widget.TvSlideshow.Button"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/medium_spacing"
        android:drawableStart="@drawable/ic_play_solid"
        android:drawablePadding="@dimen/btn_icon_gap"
        android:text="@string/start_slideshow"/>

    <!-- Область списка: во время загрузки — спиннер + «Загрузка…» по центру. -->
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="@dimen/zero_size"
        android:layout_weight="1" android:layout_marginTop="@dimen/section_spacing"
        android:clipChildren="false" android:clipToPadding="false">

        <!-- Отступы — как поля списка в прототипе; clipToPadding=false: фокусная
             рамка первой/последней строки не режется паддингами. -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/browser_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/list_edge_pad_h" android:paddingEnd="@dimen/list_edge_pad_h"
            android:paddingTop="@dimen/list_edge_pad_v" android:paddingBottom="@dimen/list_edge_pad_v"
            android:scrollbars="none"/>

        <LinearLayout android:id="@+id/browser_loading"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="horizontal"
            android:gravity="center_vertical" android:visibility="gone">
            <ProgressBar
                android:layout_width="@dimen/icon_size_small" android:layout_height="@dimen/icon_size_small"
                android:indeterminate="true" android:indeterminateTint="@color/text_primary"/>
            <TextView
                style="@style/TextAppearance.TvSlideshow.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_spacing"
                android:text="@string/loading"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
