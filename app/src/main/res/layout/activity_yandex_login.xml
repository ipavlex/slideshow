<?xml version="1.0" encoding="utf-8"?>
<!--
    Вход в Яндекс.Диск: карточка по центру с формой — логин и «пароль
    приложения» Яндекса (WebDAV, Basic auth). Выход — системная клавиша «Назад».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/screen_padding_vertical">

    <!-- Бренд слева сверху + центрированный заголовок. -->
    <TextView
        android:id="@+id/login_brand"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name"
        style="@style/TextAppearance.TvSlideshow.Caption"/>
    <TextView
        android:id="@+id/login_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/small_spacing"
        android:text="@string/login_title"
        style="@style/TextAppearance.TvSlideshow.Title"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/zero_size"
        android:layout_weight="1"/>

    <!-- Карточка: форма входа по логину и паролю приложения. -->
    <LinearLayout
        android:layout_width="@dimen/login_card_width" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/login_card"
        android:padding="@dimen/hud_padding_x">

        <!-- Инструкция: где взять пароль приложения. -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_spacing"
            android:text="@string/webdav_instruction"
            android:textColor="@color/text_secondary"
            style="@style/TextAppearance.TvSlideshow.Body"/>

        <!-- Поля: логин (actionNext) → пароль приложения (actionDone = вход). -->
        <EditText
            android:id="@+id/login_username"
            android:layout_width="match_parent" android:layout_height="@dimen/menu_item_height"
            android:background="@drawable/bg_input"
            android:hint="@string/webdav_hint_login"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:maxLines="1"
            android:paddingStart="@dimen/medium_spacing"
            android:paddingEnd="@dimen/medium_spacing"/>
        <EditText
            android:id="@+id/login_password"
            android:layout_width="match_parent" android:layout_height="@dimen/menu_item_height"
            android:layout_marginTop="@dimen/medium_spacing"
            android:background="@drawable/bg_input"
            android:hint="@string/webdav_hint_password"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:paddingStart="@dimen/medium_spacing"
            android:paddingEnd="@dimen/medium_spacing"/>

        <!-- Ряд прогресс + статус проверки. -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ProgressBar android:id="@+id/login_progress"
                android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size"
                android:indeterminate="true"
                android:visibility="gone"/>
            <TextView android:id="@+id/login_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/medium_spacing"
                style="@style/TextAppearance.TvSlideshow.Caption"/>
        </LinearLayout>

        <Button android:id="@+id/btn_login"
            android:layout_width="wrap_content" android:layout_height="@dimen/menu_item_height"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/webdav_btn_login" android:textSize="@dimen/text_caption"
            android:focusable="true" android:clickable="true"/>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/zero_size"
        android:layout_weight="1"/>
</LinearLayout>
