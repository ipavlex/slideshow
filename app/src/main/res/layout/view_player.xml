<?xml version="1.0" encoding="utf-8"?>
<!--
    Слой видео в SlideshowView. TextureView вместо SurfaceView:
    на ТВ-устройствах SurfaceView не применяет rotation-метаданные
    (вертикальные видео с телефона ложатся на бок), а TextureView
    поворачивается трансформом. Поверхность ниже фото-слоёв.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:use_controller="false" />
