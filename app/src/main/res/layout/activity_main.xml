<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/screen_padding_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="@dimen/large_spacing">
        <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_photo" android:contentDescription="@string/content_description_logo"/>
        <TextView android:id="@+id/home_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" style="@style/TextAppearance.TvSlideshow.Title" />
        <TextView android:id="@+id/home_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" style="@style/TextAppearance.TvSlideshow.Caption" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="@dimen/zero_size" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="@dimen/small_spacing">
            <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_folder" android:contentDescription="@string/content_description_folder"/>
            <Button android:id="@+id/btn_local_folder" android:layout_width="match_parent" android:layout_height="@dimen/menu_item_height" android:background="@drawable/bg_tv_button" android:text="@string/local_folder" android:textColor="@color/text_primary" android:textSize="@dimen/text_menu" android:padding="@dimen/menu_item_padding" android:focusable="true" android:clickable="true" android:stateListAnimator="@null" />
            <TextView android:id="@+id/local_folder_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/local_folder_subtitle" style="@style/TextAppearance.TvSlideshow.Caption" />
        </LinearLayout>
        <LinearLayout android:layout_width="@dimen/zero_size" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/small_spacing" android:paddingEnd="@dimen/small_spacing">
            <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_cloud" android:contentDescription="@string/yandex_disk"/>
            <Button android:id="@+id/btn_yandex" android:layout_width="match_parent" android:layout_height="@dimen/menu_item_height" android:background="@drawable/bg_tv_button" android:text="@string/yandex_disk" android:textColor="@color/text_primary" android:textSize="@dimen/text_menu" android:padding="@dimen/menu_item_padding" android:focusable="true" android:clickable="true" android:stateListAnimator="@null" />
            <TextView android:id="@+id/yandex_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/yandex_subtitle" style="@style/TextAppearance.TvSlideshow.Caption" />
        </LinearLayout>
        <LinearLayout android:layout_width="@dimen/zero_size" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/small_spacing">
            <ImageView android:layout_width="@dimen/icon_size" android:layout_height="@dimen/icon_size" android:src="@drawable/ic_settings" android:contentDescription="@string/settings"/>
            <Button android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="@dimen/menu_item_height" android:background="@drawable/bg_tv_button" android:text="@string/settings" android:textColor="@color/text_primary" android:textSize="@dimen/text_menu" android:padding="@dimen/menu_item_padding" android:focusable="true" android:clickable="true" android:stateListAnimator="@null" />
            <TextView android:id="@+id/settings_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_subtitle" style="@style/TextAppearance.TvSlideshow.Caption" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/large_spacing" android:text="@string/supported_formats" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption"/>
</LinearLayout>
