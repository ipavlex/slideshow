<?xml version="1.0" encoding="utf-8"?>
<!--
    Размеры согласованного дизайна (DESIGN.md §2).
    Эталон 1920×1080: значения в dp/sp соответствуют половине px макета.
-->
<resources>
    <dimen name="screen_padding_horizontal">48dp</dimen>
    <dimen name="screen_padding_vertical">24dp</dimen>

    <!-- Радиусы (макет: карточки/строки 20px, кнопки/поля/сегменты 12px,
         строки списков 16px — значения = px / 2) -->
    <dimen name="corner_medium">6dp</dimen>
    <dimen name="corner_large">10dp</dimen>
    <dimen name="corner_row">8dp</dimen>
    <dimen name="corner_alert">14dp</dimen>
    <dimen name="corner_segment">4.5dp</dimen>
    <dimen name="focus_stroke_width">2dp</dimen>

    <!-- Типографика -->
    <dimen name="text_title">24sp</dimen>
    <dimen name="text_screen_title">28sp</dimen>
    <dimen name="text_menu">18sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_display">26sp</dimen>
    <dimen name="text_qr_code">16sp</dimen>

    <!-- Плитки (главная, источники): крупная иконка — доминирующий элемент -->
    <dimen name="tile_width">220dp</dimen>
    <dimen name="tile_height">250dp</dimen>
    <dimen name="tile_gap">22dp</dimen>
    <dimen name="tile_icon">132dp</dimen>
    <dimen name="tile_padding">24dp</dimen>

    <!-- Строка подсказок пульта (keycap-токены: бейдж «Пауза» в OSD) -->
    <dimen name="keycap_height">22dp</dimen>
    <dimen name="keycap_pad_h">9dp</dimen>
    <dimen name="keycap_radius">5dp</dimen>
    <dimen name="keycap_text">11sp</dimen>

    <!-- Кнопка (прототип .btn): 78px высотой, ▶-иконка перед текстом -->
    <dimen name="tv_button_height">39dp</dimen>
    <dimen name="tv_button_pad_h">22dp</dimen>
    <dimen name="btn_play_icon">15dp</dimen>
    <dimen name="btn_icon_gap">7dp</dimen>

    <!-- Браузер: список строк с миниатюрой -->
    <dimen name="browser_thumb">44dp</dimen>
    <!-- Иконка-заглушка внутри миниатюры: 40px = 20dp (прототип 04). -->
    <dimen name="browser_thumb_icon">20dp</dimen>
    <dimen name="browser_row_min_h">60dp</dimen>
    <dimen name="browser_row_pad_h">14dp</dimen>
    <dimen name="browser_row_gap">4dp</dimen>

    <!-- Браузер: поля контейнера списка — свечение/масштаб фокуса не обрезается -->
    <dimen name="list_edge_pad_h">14dp</dimen>
    <dimen name="list_edge_pad_v">12dp</dimen>

    <!-- Настройки: строки и контролы -->
    <dimen name="settings_list_width">620dp</dimen>
    <dimen name="settings_row_min_h">54dp</dimen>
    <dimen name="settings_row_pad_h">20dp</dimen>
    <dimen name="settings_row_pad_v">13dp</dimen>
    <dimen name="settings_row_gap">8dp</dimen>
    <dimen name="seg_item_pad_h">14dp</dimen>
    <dimen name="seg_item_pad_v">6dp</dimen>
    <dimen name="stepper_btn">32dp</dimen>
    <dimen name="switch_w">42dp</dimen>
    <dimen name="switch_h">24dp</dimen>

    <!-- Диалог-алерт -->
    <dimen name="alert_width">330dp</dimen>
    <dimen name="alert_pad">28dp</dimen>
    <dimen name="alert_title_text">20sp</dimen>
    <dimen name="alert_actions_gap">12dp</dimen>
    <dimen name="alert_btn_min_w">110dp</dimen>

    <!-- Логин -->
    <dimen name="login_code_text">54sp</dimen>
    <!-- Ширина карточки логина: код «XXXX-XXXX» (54sp monospace) должен
         помещаться в правую колонку одной строкой — без переноса символов. -->
    <dimen name="login_card_width">720dp</dimen>
    <dimen name="login_code_gap">20dp</dimen>
    <dimen name="qr_size">160dp</dimen>
    <dimen name="qr_card_padding">12dp</dimen>
    <dimen name="login_content_width">680dp</dimen>

    <!-- OSD слайдшоу -->
    <dimen name="osd_side_padding">48dp</dimen>
    <dimen name="osd_bottom_margin">36dp</dimen>
    <dimen name="progress_height">3dp</dimen>
    <dimen name="osd_counter_text">27sp</dimen>
    <dimen name="osd_speed_text">12sp</dimen>
    <dimen name="osd_hints_margin_top">22dp</dimen>
    <dimen name="hud_padding_x">36dp</dimen>
    <dimen name="hud_padding_y">20dp</dimen>
    <dimen name="hud_text">26sp</dimen>

    <!-- Прочее (существующие токены, совместимость) -->
    <dimen name="menu_item_min_width">220dp</dimen>
    <dimen name="menu_item_height">64dp</dimen>
    <dimen name="menu_item_spacing">16dp</dimen>
    <dimen name="menu_item_padding">18dp</dimen>
    <dimen name="icon_size">32dp</dimen>
    <dimen name="icon_size_small">24dp</dimen>
    <dimen name="icon_size_large">48dp</dimen>
    <dimen name="menu_card_height">176dp</dimen>
    <dimen name="menu_card_focus_scale_z">4dp</dimen>
    <dimen name="header_height">72dp</dimen>
    <dimen name="browser_item_width">190dp</dimen>
    <dimen name="browser_item_height">190dp</dimen>
    <dimen name="thumbnail_height">80dp</dimen>
    <dimen name="list_row_height">54dp</dimen>
    <dimen name="section_spacing">24dp</dimen>
    <dimen name="button_min_width">240dp</dimen>
    <dimen name="button_height">64dp</dimen>
    <dimen name="osd_height">88dp</dimen>
    <dimen name="card_elevation">0dp</dimen>
    <dimen name="small_spacing">8dp</dimen>
    <dimen name="medium_spacing">12dp</dimen>
    <dimen name="large_spacing">28dp</dimen>
    <dimen name="settings_label_width">420dp</dimen>
    <dimen name="settings_value_width">260dp</dimen>
    <dimen name="zero_size">0dp</dimen>
</resources>
