<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatActivity требует тему AppCompat (не Leanback). -->
    <style name="Theme.TvSlideshow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Все Button на экранах получают TV-стиль с явной фокус-подсветкой. -->
        <item name="buttonStyle">@style/Widget.TvSlideshow.Button</item>
    </style>

    <!-- Кнопка: скруглённая «плитка» с фокус-подсветкой. -->
    <style name="Widget.TvSlideshow.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_tv_button</item>
        <!-- Отключаем перекраску AppCompat, иначе фокус-селектор теряет состояния. -->
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/menu_item_height</item>
        <item name="android:padding">@dimen/menu_item_padding</item>
        <item name="android:textSize">@dimen/text_menu</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Строка списка/настроек. -->
    <style name="Widget.TvSlideshow.Row" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_tv_row</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/list_row_height</item>
        <item name="android:padding">@dimen/menu_item_padding</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TextAppearance.TvSlideshow.Title" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TvSlideshow.Body" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="TextAppearance.TvSlideshow.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
</resources>
