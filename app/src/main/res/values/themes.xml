<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatActivity требует тему AppCompat (не Leanback). -->
    <style name="Theme.TvSlideshow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Все Button на экранах получают TV-стиль с явной фокус-подсветкой. -->
        <item name="buttonStyle">@style/Widget.TvSlideshow.Button</item>
    </style>

    <!-- Пункт меню: скруглённая «плитка» с крупным текстом слева и фокус-рамкой. -->
    <style name="Widget.TvSlideshow.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_tv_button</item>
        <!-- Отключаем перекраску AppCompat, иначе фокус-селектор теряет состояния. -->
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_menu</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/menu_item_height</item>
        <item name="android:minWidth">@dimen/menu_item_min_width</item>
        <item name="android:paddingStart">@dimen/menu_item_padding</item>
        <item name="android:paddingEnd">@dimen/menu_item_padding</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
